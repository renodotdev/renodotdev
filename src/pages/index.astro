                  <span>{article.data.readTime}</span>
                </div>

                <h3 class="text-lg sm:text-xl font-bold text-white group-hover:text-lime-300 transition-colors mb-3 font-sans line-clamp-2">
                  <a href={`/articles/${article.id}`}>
                    {article.data.title}
