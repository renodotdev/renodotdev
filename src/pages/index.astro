          return (
            <article class="p-6 sm:p-7 rounded-2xl border border-white/15 bg-[#0b0d12] hover:border-lime-400/50 hover:shadow-[0_0_25px_rgba(151,254,237,0.12)] transition-all duration-300 flex flex-col justify-between group">
