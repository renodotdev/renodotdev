---
import Layout from "../layouts/Layout.astro";
import { projectsData } from "@/data/projects";
import ContactForm from "@/components/ContactForm.astro";
import { getCollection } from "astro:content";

const sobatoko = projectsData.find((p) => p.id === 0)!;

const articles = await getCollection("articles");
const recentArticles = articles
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const stats = [
  {
    valKey: "stat_1_val",
    valDefault: "8+ Years",
    labelKey: "stat_1_label",
    labelDefault: "In Production",
    subKey: "stat_1_sub",
    subDefault: "Shipping apps used by thousands of daily users",
  },
  {
    valKey: "stat_2_val",
    valDefault: "1-on-1",
    labelKey: "stat_2_label",
    labelDefault: "Direct With Reno",
    subKey: "stat_2_sub",
    subDefault: "You work directly with me — no account managers",
  },
  {
    valKey: "stat_3_val",
    valDefault: "Cross-Platform",
    labelKey: "stat_3_label",
    labelDefault: "iOS, Android & Web",
    subKey: "stat_3_sub",
    subDefault: "React Native, Next.js, and modern cloud tech",
  },
  {
    valKey: "stat_4_val",
    valDefault: "Weekly",
    labelKey: "stat_4_label",
    labelDefault: "Working Demos",
    subKey: "stat_4_sub",
    subDefault: "Try real test builds on your own phone every week",
  },
];
---

<Layout
  title="renodotdev — Software Studio | Mobile, Web & AI Engineering"
  description="Independent software studio run by Della Reno Rinaldi. Building fast mobile apps, websites, and smart AI tools with senior craftsmanship and zero fluff."
  pageType="studio"
>
  <div class="min-h-screen overflow-x-hidden bg-[#08090a] text-white font-sans selection:bg-lime-400 selection:text-black">

    {/* ══════════════════════════════════════════════════════════════════
        SECTION 1: HERO & VALUE PROPOSITION
    ══════════════════════════════════════════════════════════════════ */}
    <section
      id="home"
      class="relative min-h-[85vh] flex items-center justify-center pt-20 pb-14 md:pt-32 md:pb-20 px-4 sm:px-6 overflow-hidden tech-grid-bg"
    >
      <div class="w-full max-w-[1240px] mx-auto z-10 flex flex-col items-center">
        {/* Prominent Studio Big Logo & Brand Centerpiece */}
        <div class="flex flex-col items-center mb-8 sm:mb-10 relative group w-full max-w-sm sm:max-w-none">
          {/* Ambient Radiant Glow Halo */}
          <div class="absolute -inset-6 bg-gradient-to-r from-lime-400/20 via-cyan-400/15 to-lime-400/20 rounded-full blur-3xl opacity-75 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>

          <div class="relative flex flex-col sm:flex-row items-center gap-3 sm:gap-4 px-4 sm:px-6 py-3.5 sm:py-4 rounded-2xl bg-[#0d1015]/90 border border-white/15 backdrop-blur-md shadow-2xl hover:border-lime-400/50 transition-all duration-300 max-w-full">
            {/* Big Studio Logo */}
            <img
              src="/logo/logo.svg"
              alt="renodotdev logo"
              width="254"
              height="48"
              class="h-9 sm:h-12 md:h-14 w-auto max-w-[190px] sm:max-w-none object-contain transition-transform duration-300 group-hover:scale-105"
              loading="eager"
            />

            <div class="h-8 w-px bg-white/15 hidden sm:block"></div>

            {/* Studio Availability Badge */}
            <div class="flex items-center gap-2 sm:gap-2.5 font-mono-tech text-[11px] sm:text-xs tracking-wider select-none">
              <span class="w-2.5 h-2.5 rounded-full bg-lime-400 animate-pulse shadow-[0_0_12px_#97feed]"></span>
              <span class="text-white/80 font-bold uppercase tracking-wider" data-i18n="hero_logo_tag">Studio</span>
              <span class="text-white/30">&bull;</span>
              <span class="text-lime-400 font-semibold" data-i18n="hero_badge_avail">Open for new projects</span>
            </div>
          </div>
        </div>

        {/* Clear, Punchy Headline */}
        <div class="flex flex-col items-center text-center max-w-4xl mb-8 sm:mb-10">
          <h1
            class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold uppercase leading-[1.12] sm:leading-[1.08] tracking-[-0.03em] text-white mb-5 sm:mb-6"
            data-i18n-html="hero_headline_html"
          >
            We build mobile apps, web systems &amp; <span class="text-gradient">smart AI tools</span>.
          </h1>

          <p
            class="text-sm sm:text-lg md:text-xl leading-relaxed max-w-2xl text-[#8b949e] mb-6 sm:mb-8 font-normal"
            data-i18n-html="hero_subheadline_html"
          >
            An independent software studio run by <strong class="text-white">Della Reno Rinaldi</strong>.
            With 8+ years engineering production software, I work directly with founders and teams to ship fast, reliable digital products. Honest collaboration, zero junior handoffs.
          </p>

          {/* Action CTAs */}
          <div class="flex flex-col sm:flex-row items-center justify-center gap-2.5 sm:gap-3 w-full sm:w-auto font-mono-tech text-xs">
            <a
              href="#contact"
              class="w-full sm:w-auto px-7 py-3.5 rounded font-bold uppercase tracking-wider transition-all duration-200 hover:bg-lime-300 active:scale-95 shadow-[0_0_25px_rgba(151,254,237,0.3)] flex items-center justify-center gap-2 border border-lime-400 cursor-pointer"
              style="background: #97feed; color: #08090a;"
            >
              <span data-i18n="hero_cta_start">Start a Project</span>
              <span>&rarr;</span>
            </a>

            <a
              href="#work"
              data-i18n="hero_cta_work"
              class="w-full sm:w-auto px-6 py-3.5 rounded border border-white/20 text-white hover:border-lime-400 hover:text-lime-400 font-bold uppercase tracking-wider bg-white/5 transition-all text-center"
            >
              See Our Work
            </a>

            <a
              href="https://wa.me/+6281212996550?text=Hi%20Reno,%20I'd%20like%20to%20discuss%20a%20project%20with%20renodotdev"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto px-5 py-3.5 rounded text-white/70 hover:text-lime-400 font-semibold uppercase tracking-wider flex items-center justify-center gap-1 transition-colors"
            >
              <span data-i18n="hero_cta_wa">Chat on WhatsApp</span>
              <span class="text-lime-400">&nearr;</span>
            </a>
          </div>
        </div>

        {/* Interactive Studio Engineering Showcase (Visual Centerpiece) */}
        <div class="w-full mb-10 rounded-2xl border border-white/15 bg-[#0b0d12] overflow-hidden shadow-2xl relative group">
          {/* Top Terminal Chrome / Status Bar */}
          <div class="px-3.5 sm:px-4 py-2.5 sm:py-3 bg-[#0f1218] border-b border-white/10 flex items-center justify-between text-xs font-mono-tech">
            <div class="flex items-center gap-2">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
              </div>
              <span class="text-white/40 ml-2 hidden sm:inline text-[11px]">renodotdev://studio-systems/live-preview</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="flex items-center gap-1.5 text-[11px] text-lime-400 font-semibold">
                <span class="w-2 h-2 rounded-full bg-lime-400 animate-pulse"></span>
                <span>PRODUCTION READY</span>
              </span>
              <span class="text-white/30 hidden md:inline">&bull;</span>
              <span class="text-white/50 text-[11px] hidden md:inline">MALANG &bull; REMOTE GLOBAL</span>
            </div>
          </div>

          {/* Main Showcase Banner & Illustration Stage */}
          <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-0 overflow-hidden">
            {/* Left: 3D Studio Illustration Visual */}
            <div class="lg:col-span-7 relative min-h-[260px] sm:min-h-[380px] overflow-hidden bg-black/40 flex items-center justify-center">
              <img
                src="/images/studio-showcase.jpg"
                alt="renodotdev Software Engineering Studio - Mobile, Web & AI Architecture"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0b0d12] via-transparent to-black/30 lg:bg-gradient-to-r lg:from-transparent lg:to-[#0b0d12]"></div>

              {/* Floating Live Telemetry Badge on Image */}
              <div class="absolute top-3 sm:top-4 left-3 sm:left-4 p-2 sm:p-2.5 rounded-lg bg-black/80 backdrop-blur-md border border-white/15 font-mono-tech text-[9px] sm:text-[10px] text-white flex items-center gap-1.5 sm:gap-2 shadow-xl">
                <span class="w-2 h-2 rounded-full bg-lime-400 animate-ping"></span>
                <span class="text-lime-400 font-bold">CORE DOMAINS:</span>
                <span class="text-white/80">React Native POS &bull; Web SaaS &bull; AI</span>
              </div>
            </div>

            {/* Right: Technical Capabilities & Founder Credit */}
            <div class="lg:col-span-5 p-5 sm:p-8 flex flex-col justify-between bg-[#0e1117] border-t lg:border-t-0 lg:border-l border-white/10 font-mono-tech">
              <div>
                <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-lime-400/10 text-lime-400 border border-lime-400/25 text-[10px] sm:text-[11px] font-bold uppercase tracking-wider mb-3 sm:mb-4">
                  <span data-i18n="hero_showcase_badge">Production Architecture Preview</span>
                </div>

                <h3 class="text-lg sm:text-2xl font-bold text-white mb-2 font-sans" data-i18n="hero_showcase_title">
                  Engineered for Raw Speed, Stability &amp; Scale
                </h3>

                <p class="text-xs text-[#8b949e] font-sans leading-relaxed mb-5 sm:mb-6" data-i18n="hero_showcase_sub">
                  Every application is architected directly by Reno — from reactive mobile state to fast edge API gateways.
                </p>

                {/* 3 Metric Pills */}
                <div class="grid grid-cols-3 gap-1.5 sm:gap-2.5 mb-5 sm:mb-6 text-center">
                  <div class="p-2 sm:p-3 rounded-xl bg-black/50 border border-white/10">
                    <span class="text-sm sm:text-lg font-extrabold text-lime-400 block" data-i18n="hero_showcase_stat1_val">60 FPS</span>
                    <span class="text-[9px] sm:text-[10px] text-white/50 block font-sans" data-i18n="hero_showcase_stat1_lbl">Smooth Native</span>
                  </div>
                  <div class="p-2 sm:p-3 rounded-xl bg-black/50 border border-white/10">
                    <span class="text-sm sm:text-lg font-extrabold text-lime-400 block" data-i18n="hero_showcase_stat2_val">&lt;50ms</span>
                    <span class="text-[9px] sm:text-[10px] text-white/50 block font-sans" data-i18n="hero_showcase_stat2_lbl">Edge Latency</span>
                  </div>
                  <div class="p-2 sm:p-3 rounded-xl bg-black/50 border border-white/10">
                    <span class="text-sm sm:text-lg font-extrabold text-lime-400 block" data-i18n="hero_showcase_stat3_val">100%</span>
                    <span class="text-[9px] sm:text-[10px] text-white/50 block font-sans" data-i18n="hero_showcase_stat3_lbl">Code Ownership</span>
                  </div>
                </div>
              </div>

              {/* Founder Verification Strip */}
              <div class="pt-4 border-t border-white/10 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full overflow-hidden border border-lime-400 shrink-0 shadow-md">
                    <img
                      src="/photos/founder-avatar.jpeg"
                      alt="Della Reno Rinaldi"
                      width="40"
                      height="40"
                      class="w-full h-full object-cover object-top"
                      loading="eager"
                    />
                  </div>
                  <div>
                    <p class="text-xs font-bold text-white font-sans leading-tight">Della Reno Rinaldi</p>
                    <p class="text-[11px] text-lime-400 font-mono-tech">Studio Founder &bull; Lead Systems Engineer</p>
                  </div>
                </div>

                <a
                  href="/profile"
                  class="text-xs text-white/70 hover:text-lime-400 transition-colors uppercase font-bold text-[10px]"
                >
                  Bio &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* Grounded Stats Bar */}
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-0 w-full border border-white/15 rounded-xl overflow-hidden bg-[#0c0e12] font-mono-tech shadow-xl">
          {stats.map((stat, idx) => (
            <div class={`p-5 sm:p-6 border-b lg:border-b-0 ${idx < 3 ? 'lg:border-r' : ''} border-white/15 hover:bg-white/[0.02] transition-colors`}>
              <span class="text-2xl sm:text-3xl font-extrabold text-white block mb-1" data-i18n={stat.valKey}>
                {stat.valDefault}
              </span>
              <h4 class="text-xs font-bold text-lime-400 uppercase tracking-wider mb-1" data-i18n={stat.labelKey}>
                {stat.labelDefault}
              </h4>
              <p class="text-xs text-white/50 leading-relaxed font-sans" data-i18n={stat.subKey}>
                {stat.subDefault}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ══════════════════════════════════════════════════════════════════
        SECTION 2: FEATURED WORK (SOBATOKO & NEXT PROJECT INVITATION)
    ══════════════════════════════════════════════════════════════════ */}
    <section
      id="work"
      class="py-20 md:py-24 px-5 md:px-6 max-w-[1240px] mx-auto border-t border-white/10"
    >
      <div class="flex flex-col items-center text-center mb-12">
        <span class="text-xs font-mono-tech font-bold uppercase tracking-widest text-lime-400 mb-2" data-i18n="work_kicker">
          Featured Work
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-sans mb-3" data-i18n="work_title">
          Sobatoko &bull; POS &amp; Store Platform
        </h2>
        <p class="text-sm text-[#8b949e] max-w-xl font-sans" data-i18n="work_desc">
          A complete retail and cashier system built from the ground up: fast sales, real-time inventory, hardware receipt printing, and digital storefronts.
        </p>
      </div>

      {/* Case Study Card */}
      <div class="rounded-2xl overflow-hidden border border-white/15 flex flex-col md:flex-row bg-[#0b0d11] hover:border-lime-400/40 transition-all duration-300 mb-10 shadow-2xl">
        {/* Brand visual panel & POS Illustration */}
        <div class="md:w-1/2 relative min-h-[320px] sm:min-h-[380px] overflow-hidden bg-black/60 flex items-center justify-center group">
          <img
            src="/images/pos-showcase.jpg"
            alt="Sobatoko POS Terminal & Hardware Thermal Printing"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0e1116] via-transparent to-black/40"></div>

          {/* Floating Sobatoko Logo Badge */}
          <div class="absolute top-4 left-4 p-3 rounded-xl bg-white/95 backdrop-blur-md shadow-2xl border border-white/20 transition-transform duration-300 group-hover:scale-105">
            <img
              src={sobatoko.image}
              alt="Sobatoko logo"
              class="h-8 sm:h-9 w-auto object-contain"
            />
          </div>

          <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs font-mono-tech text-white/90 font-bold uppercase tracking-wider bg-black/75 backdrop-blur-md px-3.5 py-2 rounded-lg border border-white/10 shadow-lg">
            <span class="flex items-center gap-1.5" data-i18n="work_production_tag">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Production Web &amp; Mobile POS</span>
            </span>
            <span class="text-lime-400" data-i18n="work_status_ok">Live Status: OK</span>
          </div>
        </div>

        {/* Technical Breakdown */}
        <div class="p-7 sm:p-9 md:w-1/2 flex flex-col justify-center bg-[#0e1116] border-t md:border-t-0 md:border-l border-white/15 font-mono-tech">
          <div class="flex items-center gap-2 mb-3">
            <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-lime-400/15 text-lime-400 border border-lime-400/30" data-i18n="work_badge_deploy">
              Live in Production
            </span>
          </div>

          <h3 class="text-2xl font-bold text-white mb-2 font-sans">
            {sobatoko.name}
          </h3>

          <p class="text-xs sm:text-sm leading-relaxed text-[#8b949e] mb-6 font-sans" data-i18n="work_sobatoko_sub">
            An end-to-end POS, inventory, and online store platform built for retail &amp; F&amp;B owners. Designed, engineered, and deployed live by renodotdev.
          </p>

          <div class="mb-6 space-y-2 text-xs font-sans text-white/70">
            <div class="flex items-start gap-2">
              <span class="text-lime-400 font-mono font-bold mt-0.5">&bull;</span>
              <span data-i18n="work_sobatoko_feat1">Full-stack architecture built on Next.js and PostgreSQL for instant response times</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-lime-400 font-mono font-bold mt-0.5">&bull;</span>
              <span data-i18n="work_sobatoko_feat2">Real-time stock sync across multiple cashier counters and branch locations</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-lime-400 font-mono font-bold mt-0.5">&bull;</span>
              <span data-i18n="work_sobatoko_feat3">Plug-and-play Bluetooth &amp; LAN thermal receipt printer support</span>
            </div>
          </div>

          <div class="flex flex-wrap gap-1.5 mb-6">
            {sobatoko.techStack.map((tech) => (
              <span class="px-2.5 py-1 rounded text-xs font-semibold bg-black/60 text-white/80 border border-white/10">
                {tech}
              </span>
            ))}
          </div>

          {sobatoko.siteUrl && (
            <div>
              <a
                href={sobatoko.siteUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-2.5 rounded text-xs font-bold uppercase tracking-wider bg-lime-400 text-black hover:bg-lime-300 transition-colors shadow-[0_0_20px_rgba(151,254,237,0.3)] border border-lime-400"
              >
                <span data-i18n="work_btn_visit">Visit Sobatoko.com</span>
                <span>&nearr;</span>
              </a>
            </div>
          )}
        </div>
      </div>

      {/* Studio Labs & Developed Tooling Grid */}
      <div class="mb-10">
        <div class="flex items-center justify-between mb-4 font-mono-tech text-xs">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-lime-400"></span>
            <span class="text-white/60 font-bold uppercase tracking-wider">Studio Tooling &amp; Incubated Products &bull; renodotdev Labs</span>
          </div>
          <a
            href="/profile"
            class="text-lime-400 hover:text-white font-bold transition-colors hidden sm:inline-flex items-center gap-1"
          >
            <span>Individual Career History &rarr;</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {/* Card 1: Sobatoko Mobile POS Companion */}
          <div class="p-6 sm:p-7 rounded-2xl border border-white/15 bg-[#0b0d12] hover:border-lime-400/40 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-3 font-mono-tech text-xs">
                <span class="px-2.5 py-0.5 rounded bg-lime-400/10 text-lime-400 border border-lime-400/25 font-bold uppercase">
                  Studio Product &bull; Native POS
                </span>
                <span class="text-lime-400 font-bold">iOS &amp; Android</span>
              </div>

              <h4 class="text-xl font-bold text-white mb-2 font-sans group-hover:text-lime-300 transition-colors">
                Sobatoko Mobile Cashier Terminal
              </h4>

              <p class="text-xs sm:text-sm text-[#8b949e] leading-relaxed mb-5 font-sans">
                Native retail cashier companion designed for touch-first handheld and tablet operations with local SQLite storage for uninterrupted offline checkout.
              </p>

              <div class="space-y-1.5 text-xs font-sans text-white/70 mb-5">
                <div class="flex items-center gap-2">
                  <span class="text-lime-400 font-mono font-bold">&bull;</span>
                  <span>Instant transaction processing with zero reliance on cloud roundtrips</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-lime-400 font-mono font-bold">&bull;</span>
                  <span>Direct Bluetooth Low Energy (BLE) connection to mobile thermal printers</span>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-white/10 flex items-center justify-between font-mono-tech text-xs">
              <div class="flex flex-wrap gap-1.5">
                {["React Native", "Expo", "SQLite", "ESC/POS"].map((t) => (
                  <span class="px-2 py-0.5 rounded text-[10px] bg-black/60 text-white/70 border border-white/10">
                    {t}
                  </span>
                ))}
              </div>

              <span class="text-white/40 text-[11px] font-mono-tech">Internal Product</span>
            </div>
          </div>

          {/* Card 2: PrintBridge ESC/POS Hardware Engine */}
          <div class="p-6 sm:p-7 rounded-2xl border border-white/15 bg-[#0b0d12] hover:border-lime-400/40 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-3 font-mono-tech text-xs">
                <span class="px-2.5 py-0.5 rounded bg-cyan-400/10 text-cyan-300 border border-cyan-400/25 font-bold uppercase">
                  Studio Utility &bull; Hardware Driver
                </span>
                <span class="text-cyan-300 font-bold">Zero Overhead</span>
              </div>

              <h4 class="text-xl font-bold text-white mb-2 font-sans group-hover:text-cyan-300 transition-colors">
                PrintBridge ESC/POS Engine
              </h4>

              <p class="text-xs sm:text-sm text-[#8b949e] leading-relaxed mb-5 font-sans">
                Lightweight hardware communication protocol developed to stream raw byte receipt buffers across Bluetooth, USB, and LAN thermal receipt printers.
              </p>

              <div class="space-y-1.5 text-xs font-sans text-white/70 mb-5">
                <div class="flex items-center gap-2">
                  <span class="text-lime-400 font-mono font-bold">&bull;</span>
                  <span>Sub-150ms print job dispatch with automatic buffer slicing and paper cut</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-lime-400 font-mono font-bold">&bull;</span>
                  <span>Eliminates dependency on fragile third-party native printing libraries</span>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-white/10 flex items-center justify-between font-mono-tech text-xs">
              <div class="flex flex-wrap gap-1.5">
                {["TypeScript", "Raw Sockets", "BLE", "Thermal Print"].map((t) => (
                  <span class="px-2 py-0.5 rounded text-[10px] bg-black/60 text-white/70 border border-white/10">
                    {t}
                  </span>
                ))}
              </div>

