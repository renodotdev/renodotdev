---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const formattedDate = article.data.publishDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// JSON-LD structured data for article SEO
const schemaData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.publishDate.toISOString(),
  author: {
    "@type": "Person",
    name: "Della Reno Rinaldi",
    url: "https://renodotdev.com/profile",
  },
  publisher: {
    "@type": "Organization",
    name: "renodotdev Studio",
    url: "https://renodotdev.com",
    logo: {
      "@type": "ImageObject",
      url: "https://renodotdev.com/logo/logo.svg",
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `https://renodotdev.com/articles/${article.id}`,
  },
  keywords: article.data.tags.join(", "),
};
---

<Layout
  title={`${article.data.title} — renodotdev Engineering Publications`}
  description={article.data.description}
  pageType="articles"
>
  <!-- Schema.org Article Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-16 md:top-20 left-0 h-[2px] bg-gradient-to-r from-lime-400 to-cyan-400 z-40 w-0 transition-all duration-100 ease-out pointer-events-none"></div>

  <article class="min-h-screen bg-[#08090a] text-white font-sans selection:bg-lime-400 selection:text-black py-16 md:py-24 px-4 sm:px-6">
    <div class="max-w-[820px] mx-auto">
      {/* Navigation Breadcrumb */}
      <nav class="flex items-center gap-2 text-xs font-mono-tech text-white/50 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-lime-400 transition-colors">Studio</a>
        <span>/</span>
        <a href="/articles" class="hover:text-lime-400 transition-colors">Publications</a>
        <span>/</span>
        <span class="text-lime-400 truncate max-w-[200px] sm:max-w-none">{article.data.title}</span>
      </nav>

      {/* Article Header */}
      <header class="mb-10 pb-8 border-b border-white/10">
        <div class="flex flex-wrap items-center gap-3 font-mono-tech text-xs text-white/50 mb-4">
          <span class="px-2.5 py-0.5 rounded bg-lime-400/10 text-lime-400 border border-lime-400/30 font-bold uppercase tracking-wider">
            {article.data.audience}
          </span>
          <span>&bull;</span>
          <time datetime={article.data.publishDate.toISOString()}>{formattedDate}</time>
          <span>&bull;</span>
          <span>{article.data.readTime}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-[1.15] mb-5">
          {article.data.title}
        </h1>

        <p class="text-lg sm:text-xl text-[#8b949e] leading-relaxed mb-6 font-normal">
          {article.data.description}
        </p>

        {/* Author Byline */}
        <div class="flex items-center justify-between pt-4 border-t border-white/10">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full overflow-hidden border border-lime-400/50 shrink-0 bg-[#0e1116]">
              <img
                src="/photos/founder-avatar.jpeg"
                alt="Della Reno Rinaldi"
                width="40"
                height="40"
                class="w-full h-full object-cover object-top"
              />
            </div>
            <div>
              <p class="text-xs font-bold text-white font-sans">Della Reno Rinaldi</p>
              <p class="text-[11px] text-lime-400 font-mono-tech">Founder &bull; Lead Systems Engineer</p>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-1.5">
            {article.data.tags.map((tag) => (
              <a
                href={`/articles?tag=${encodeURIComponent(tag.toLowerCase())}`}
                class="px-2.5 py-0.5 rounded text-[11px] font-mono-tech bg-white/5 text-white/70 border border-white/10 hover:border-lime-400/50 hover:text-lime-300 hover:bg-lime-400/10 transition-colors"
                title={`Explore all articles tagged #${tag}`}
              >
                #{tag}
              </a>
            ))}
          </div>
        </div>
      </header>

      {/* Markdown Content Reader Styling */}
      <div class="article-content font-sans text-[15px] sm:text-[17px] text-[#c9d1d9] leading-[1.8] space-y-6">
        <Content />
      </div>

      {/* Author Bio Box */}
      <div class="mt-16 p-6 sm:p-8 rounded-2xl border border-white/15 bg-[#0b0d12] font-mono-tech shadow-xl">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-5 text-center sm:text-left">
          <div class="w-16 h-16 rounded-2xl overflow-hidden border border-lime-400 shrink-0 shadow-lg bg-[#0e1116]">
            <img
              src="/photos/founder-avatar.jpeg"
              alt="Della Reno Rinaldi"
              width="64"
              height="64"
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div class="flex-1">
            <div class="flex items-center justify-center sm:justify-between mb-1">
              <h3 class="text-base font-bold text-white font-sans">Written by Della Reno Rinaldi</h3>
              <span class="text-[10px] text-lime-400 font-bold uppercase tracking-wider hidden sm:inline">Studio Founder &bull; Lead Systems Engineer</span>
            </div>
            <p class="text-xs sm:text-sm text-[#8b949e] font-sans leading-relaxed mb-4">
              Founder of renodotdev and Sobatoko. Over 8 years engineering production mobile applications, retail POS architectures, and full-stack web platforms used by thousands of daily users.
            </p>
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 text-xs">
              <a
                href="/profile"
                class="text-lime-400 hover:underline font-bold"
              >
                Career Profile &rarr;
              </a>
              <span class="text-white/20">&bull;</span>
              <a
                href="https://wa.me/+6281212996550?text=Hi%20Reno,%20I%20read%20your%20article%20and%20want%20to%20connect"
                target="_blank"
                rel="noopener noreferrer"
                class="text-white/70 hover:text-white"
              >
                WhatsApp Direct &nearr;
              </a>
              <span class="text-white/20">&bull;</span>
              <a
                href="mailto:renodotdev@gmail.com"
                class="text-white/70 hover:text-white"
              >
                renodotdev@gmail.com
              </a>
            </div>
          </div>
        </div>
      </div>

      {/* Floating / Bottom Studio Conversion Card */}
      <div class="mt-8 p-8 rounded-2xl border border-lime-400/40 bg-gradient-to-b from-[#0e1319] to-[#08090a] font-mono-tech shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded bg-lime-400/10 text-lime-400 border border-lime-400/30 text-[10px] font-bold uppercase tracking-wider mb-2">
            <span>● Production Sprints</span>
          </div>
          <h3 class="text-xl font-bold text-white font-sans mb-1">
            Have a project with similar challenges?
          </h3>
          <p class="text-xs text-[#8b949e] font-sans max-w-lg leading-relaxed">
            From React Native mobile apps to multi-tenant web platforms and AI tools, we build with senior craftsmanship and zero junior handoffs.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-2.5 w-full md:w-auto shrink-0 text-xs">
          <a
            href="/#contact"
            class="px-5 py-3 rounded-xl bg-lime-400 text-black font-bold uppercase tracking-wider hover:bg-lime-300 transition-all text-center border border-lime-400 shadow-[0_0_15px_rgba(151,254,237,0.3)]"
          >
            Start a Project &rarr;
          </a>
          <a
            href="/articles"
            class="px-4 py-3 rounded-xl border border-white/20 text-white/80 hover:text-white hover:border-white/40 bg-white/5 font-semibold uppercase tracking-wider text-center transition-all"
          >
            All Articles
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  /* Markdown Reader Typography styling */
  .article-content h2 {
    font-size: 1.65rem;
    font-weight: 800;
    color: #ffffff;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 0.5rem;
  }
  .article-content h3 {
    font-size: 1.3rem;
    font-weight: 700;
    color: #ffffff;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }
  .article-content p {
    margin-bottom: 1.35rem;
    color: #a7b3c2;
    line-height: 1.8;
  }
  .article-content strong {
    color: #ffffff;
    font-weight: 700;
  }
  .article-content a {
    color: #97feed;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }
  .article-content a:hover {
    color: #c5fff7;
  }
  .article-content ul, .article-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    color: #a7b3c2;
  }
  .article-content ul {
    list-style-type: disc;
  }
  .article-content ol {
    list-style-type: decimal;
  }
  .article-content li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }
  .article-content blockquote {
    border-left: 3px solid #97feed;
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: #8b949e;
    font-style: italic;
    background: rgba(151, 254, 237, 0.03);
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .article-content pre {
    background: #0d1117 !important;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.85rem;
    padding: 1.25rem;
    margin: 1.75rem 0;
    overflow-x: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    line-height: 1.6;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }
  .article-content code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.88em;
    background: rgba(255, 255, 255, 0.08);
    color: #97feed;
    padding: 0.15rem 0.4rem;
    border-radius: 0.35rem;
  }
  .article-content pre code {
    background: transparent;
    padding: 0;
    color: inherit;
  }
  .article-content hr {
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin: 2.5rem 0;
  }
</style>

<script>
  function updateProgress() {
    const bar = document.getElementById("reading-progress");
    if (!bar) return;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (docHeight <= 0) {
      bar.style.width = "0%";
      return;
    }
    const scrolled = (window.scrollY / docHeight) * 100;
    bar.style.width = Math.min(100, Math.max(0, scrolled)) + "%";
  }

  window.addEventListener("scroll", updateProgress, { passive: true });
  updateProgress();
  document.addEventListener("astro:page-load", updateProgress);
</script>
