---
interface Props {
  pageType?: "studio" | "profile" | "articles";
}

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isProfile = pathname.startsWith("/profile");
const isArticles = pathname.startsWith("/articles");
const isHome = pathname === "/";

const {
  pageType = isProfile ? "profile" : isArticles ? "articles" : "studio",
} = Astro.props;

// 1. Contextual Navigation (clean in-page anchors & page flows)
const homeSections = [
  { name: "Services", href: "#services", section: "services", i18nKey: "nav_services" },
  { name: "Products", href: "#work", section: "work", i18nKey: "nav_work" },
  { name: "Founder", href: "/profile", section: "founder", i18nKey: "nav_founder_bio" },
  { name: "Contact", href: "#contact", section: "contact", i18nKey: "nav_contact" },
];

const profileSections = [
  { name: "← Studio", href: "/", section: "studio", i18nKey: "nav_return_studio" },
  { name: "Experience", href: "#experience", section: "experience", i18nKey: "p_nav_experience" },
  { name: "Work", href: "#work", section: "work", i18nKey: "p_nav_work" },
  { name: "Contact", href: "#contact", section: "contact", i18nKey: "p_nav_contact" },
];

const articleSections = [
  { name: "← Studio", href: "/", section: "studio", i18nKey: "nav_return_studio" },
  { name: "Founder", href: "/profile", section: "founder", i18nKey: "nav_founder_bio" },
  { name: "Contact", href: "/#contact", section: "contact", i18nKey: "nav_contact" },
];

const activeSections = isProfile
  ? profileSections
  : isArticles
  ? articleSections
  : homeSections;
---

<header
  class="fixed top-0 w-full z-50 backdrop-blur-xl border-b border-white/10"
  style="background: rgba(8, 9, 10, 0.94);"
>
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <div class="flex justify-between items-center h-16 md:h-20">
      
      {/* ── LEFT: Studio Logo & Context Stamp ────────────────── */}
      <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
        <a
          href={isProfile ? "/profile#home" : "/#home"}
          class="cursor-pointer flex items-center gap-2 sm:gap-2.5 nav-scroll-link group"
          aria-label="renodotdev home"
        >
          <img
            src="/logo/logo.svg"
            alt="renodotdev"
            width="254"
            height="48"
            class="h-8 sm:h-9 md:h-11 w-auto max-w-[145px] sm:max-w-none object-contain transition-transform group-hover:scale-105"
          />
          {isProfile ? (
            <span class="hidden sm:inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-white/10 text-white/70 border border-white/15 font-mono-tech">
              Founder
            </span>
          ) : isArticles ? (
            <span class="hidden sm:inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-lime-400/10 text-lime-400 border border-lime-400/30 font-mono-tech">
              Journal
            </span>
          ) : (
            <span class="hidden sm:inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-lime-400/10 text-lime-400 border border-lime-400/30 font-mono-tech">
              Studio
            </span>
          )}
        </a>
      </div>

      {/* ── CENTER: Clean Unified Section Navigation Island ──────── */}
      <nav class="hidden lg:flex items-center font-mono-tech text-xs tracking-wider" id="desktop-nav">
        <div class="flex items-center gap-1 p-1 rounded-full bg-white/[0.04] border border-white/10 shadow-inner backdrop-blur-md">
          {activeSections.map((link) => (
            <a
              href={link.href}
              data-section={link.section}
              data-i18n={link.i18nKey || undefined}
              class="nav-link px-3.5 py-1.5 rounded-full transition-all duration-200 text-[#8b949e] hover:text-white hover:bg-white/10 font-medium cursor-pointer"
            >
              {link.name}
            </a>
          ))}
        </div>
      </nav>

      {/* ── RIGHT: Dedicated Articles Destination, Lang, Action CTA ─ */}
      <div class="hidden lg:flex items-center gap-3 shrink-0">
        
        {/* Dedicated Top-Level Destination: Articles Hub (Cleanly Separated!) */}
        <a
          href="/articles"
          class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-xs font-mono-tech transition-all duration-200 cursor-pointer shadow-sm ${
            isArticles
              ? "bg-lime-400 text-black border-lime-400 font-bold shadow-[0_0_20px_rgba(151,254,237,0.35)]"
              : "bg-[#0d1015] border-white/15 text-white/80 hover:text-white hover:border-lime-400/50 hover:bg-white/5 font-medium"
          }`}
          title="Read engineering publications & blueprints"
        >
          <span class={`w-1.5 h-1.5 rounded-full ${isArticles ? "bg-black animate-pulse" : "bg-lime-400"}`}></span>
          <span data-i18n="nav_articles">Articles</span>
        </a>

        {/* Vertical Divider */}
        <div class="h-4 w-px bg-white/15"></div>

        {/* Language Switcher Pill */}
        <div class="inline-flex items-center p-0.5 rounded-lg border border-white/15 bg-white/5 font-mono-tech text-[11px] select-none">
          <button
            type="button"
            class="lang-switch-btn px-2.5 py-1 rounded font-bold uppercase transition-all cursor-pointer"
            data-lang="en"
            title="English"
            aria-label="Switch language to English"
          >
            EN
          </button>
          <button
            type="button"
            class="lang-switch-btn px-2.5 py-1 rounded font-bold uppercase transition-all cursor-pointer"
            data-lang="id"
            title="Bahasa Indonesia"
            aria-label="Switch language to Indonesian"
          >
            ID
          </button>
        </div>

        {/* Primary Action Button */}
        {isProfile ? (
          <a
            href="#contact"
            data-i18n="p_hero_btn_contact"
            class="nav-scroll-link flex items-center justify-center px-5 py-2 rounded-lg text-xs font-bold uppercase tracking-wider transition-all duration-200 hover:bg-lime-300 active:scale-95 shadow-[0_0_20px_rgba(151,254,237,0.25)] border border-lime-400 cursor-pointer font-mono-tech"
            style="background: #97feed; color: #08090a;"
          >
            Say Hello &rarr;
          </a>
        ) : (
          <a
            href={isHome ? "#contact" : "/#contact"}
            data-i18n="nav_start_project"
            class="nav-scroll-link flex items-center justify-center px-5 py-2 rounded-lg text-xs font-bold uppercase tracking-wider transition-all duration-200 hover:bg-lime-300 active:scale-95 shadow-[0_0_20px_rgba(151,254,237,0.25)] border border-lime-400 cursor-pointer font-mono-tech"
            style="background: #97feed; color: #08090a;"
          >
            Start a Project
          </a>
        )}
      </div>

      {/* ── MOBILE / TABLET CONTROLS (< lg) ─────────────────────── */}
      <div class="flex items-center gap-2 sm:gap-2.5 lg:hidden">
        {/* Quick Hub Jump (Articles Pill on tablet) */}
        {!isArticles && (
          <a
            href="/articles"
            class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-lime-400/30 bg-lime-400/10 text-lime-400 text-[11px] font-mono-tech font-bold"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-lime-400"></span>
            <span>Articles</span>
          </a>
        )}

        {/* Mobile Language Switcher Pill */}
        <div class="inline-flex items-center p-0.5 rounded-lg border border-white/15 bg-white/5 font-mono-tech text-[10px] select-none">
          <button
            type="button"
            class="lang-switch-btn px-2 py-0.5 rounded font-bold transition-all cursor-pointer"
            data-lang="en"
            aria-label="English"
          >
            EN
          </button>
          <button
            type="button"
            class="lang-switch-btn px-2 py-0.5 rounded font-bold transition-all cursor-pointer"
            data-lang="id"
            aria-label="Indonesian"
          >
            ID
          </button>
        </div>

        {/* Mobile Hamburger Toggle Button */}
        <button
          id="menu-toggle-btn"
          type="button"
          class="inline-flex items-center justify-center p-2 rounded-xl border border-white/15 bg-white/5 transition-all duration-200 focus:outline-none text-white hover:border-lime-400/50 hover:bg-white/10 active:scale-95 cursor-pointer shadow-sm"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <svg
            id="menu-icon-open"
            class="block h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="menu-icon-close"
            class="hidden h-5 w-5 text-lime-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  {/* ── MOBILE NAVIGATION DRAWER OVERLAY ───────────────────────── */}
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-white/15 bg-[#08090a]/98 backdrop-blur-2xl shadow-2xl max-h-[calc(100vh-4rem)] overflow-y-auto"
  >
    <div class="px-4 sm:px-6 pt-4 pb-8 space-y-4">
      
      {/* 1. Context Switcher Card (Studio <-> Profile) */}
      {isProfile ? (
        <a
          href="/"
          class="flex items-center justify-between p-3.5 rounded-xl bg-lime-400/10 border border-lime-400/30 hover:bg-lime-400/15 transition-all group shadow-md"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-lime-400/20 text-lime-400 border border-lime-400/30 flex items-center justify-center font-bold font-mono-tech text-xs shrink-0">
              &gt;R
            </div>
            <div>
              <p class="text-xs font-bold text-white group-hover:text-lime-400 transition-colors">renodotdev Studio</p>
              <p class="text-[10px] text-lime-400 font-mono-tech" data-i18n="p_banner_back">&larr; Return to Studio &amp; Services</p>
            </div>
          </div>
          <span class="text-lime-400 font-mono-tech text-xs font-bold px-2 py-1 rounded bg-lime-400/20">&larr;</span>
        </a>
      ) : (
        <a
          href="/profile"
          class="flex items-center justify-between p-3.5 rounded-xl bg-gradient-to-r from-white/[0.08] to-white/[0.02] border border-white/15 hover:border-lime-400/50 transition-all group shadow-md"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full overflow-hidden border border-lime-400 shrink-0 shadow-sm">
              <img
                src="/photos/founder-avatar.jpeg"
                alt="Della Reno Rinaldi"
                width="36"
                height="36"
                class="w-full h-full object-cover object-top"
              />
            </div>
            <div>
              <p class="text-xs font-bold text-white group-hover:text-lime-400 transition-colors">Della Reno Rinaldi</p>
              <p class="text-[10px] text-white/50 font-mono-tech" data-i18n="nav_founder_bio">About Reno &bull; Individual Career Track</p>
            </div>
          </div>
          <span class="text-lime-400 font-mono-tech text-xs font-bold px-2 py-1 rounded bg-white/5">&rarr;</span>
        </a>
      )}

      {/* 2. In-Page Sections Cluster */}
      <div class="space-y-1">
        <span class="text-[10px] uppercase font-mono-tech text-white/40 tracking-wider block px-1 mb-1">
          {isProfile ? "Profile Sections" : isArticles ? "Articles Overview" : "Page Sections"}
        </span>
        {activeSections.map((link) => (
          <a
            href={link.href}
            data-section={link.section}
            data-i18n={link.i18nKey || undefined}
            class="mobile-nav-link flex items-center justify-between px-4 py-3 rounded-xl text-xs font-bold uppercase tracking-wider transition-all font-mono-tech text-[#8b949e] hover:text-white hover:bg-white/5 border border-transparent hover:border-white/10 active:scale-[0.99]"
          >
            <span>{link.name}</span>
            <span class="text-white/20 text-sm font-bold">&rsaquo;</span>
          </a>
        ))}
      </div>

      {/* 3. Distinct Featured Articles Card (Completely separate from sections!) */}
      <div class="pt-2">
        <span class="text-[10px] uppercase font-mono-tech text-white/40 tracking-wider block px-1 mb-1.5">
          Engineering Journal
        </span>
        <a
          href="/articles"
          class={`flex items-center justify-between p-3.5 rounded-xl border transition-all ${
            isArticles
              ? "bg-lime-400/15 border-lime-400/50 text-white"
              : "bg-[#0c0e12] border-white/15 hover:border-lime-400/40"
          }`}
        >
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-lime-400/10 text-lime-400 border border-lime-400/25 flex items-center justify-center font-bold text-xs shrink-0">
              ✦
            </div>
            <div>
              <p class="text-xs font-bold text-white">Articles &amp; Architecture</p>
              <p class="text-[10px] text-[#8b949e]">Production engineering blueprints &amp; teardowns</p>
            </div>
          </div>
          <span class="text-lime-400 font-mono-tech font-bold text-xs">&rarr;</span>
        </a>
      </div>

      {/* 4. Action CTAs */}
      <div class="pt-2 border-t border-white/10 flex flex-col gap-2.5">
        {isProfile ? (
          <a
            href="#contact"
            data-i18n="p_hero_btn_contact"
            class="nav-scroll-link block w-full text-center py-3.5 px-6 rounded-xl text-xs font-bold uppercase tracking-wider bg-lime-400 text-black shadow-[0_0_25px_rgba(151,254,237,0.3)] font-mono-tech hover:bg-lime-300 active:scale-95 transition-all border border-lime-400"
          >
            Say Hello &rarr;
          </a>
        ) : (
          <a
            href={isHome ? "#contact" : "/#contact"}
            data-i18n="nav_start_project"
            class="nav-scroll-link block w-full text-center py-3.5 px-6 rounded-xl text-xs font-bold uppercase tracking-wider bg-lime-400 text-black shadow-[0_0_25px_rgba(151,254,237,0.3)] font-mono-tech hover:bg-lime-300 active:scale-95 transition-all border border-lime-400"
          >
            Start a Project
          </a>
        )}

        <a
          href="https://wa.me/+6281212996550?text=Hi%20Reno,%20I'd%20like%20to%20discuss%20a%20project%20with%20renodotdev"
          target="_blank"
          rel="noopener noreferrer"
          class="block w-full text-center py-3 px-5 rounded-xl text-xs font-bold uppercase tracking-wider border border-white/15 text-white/80 hover:text-lime-400 hover:border-lime-400/40 bg-white/5 font-mono-tech transition-all flex items-center justify-center gap-1.5"
        >
          <span>Chat on WhatsApp</span>
          <span class="text-lime-400">&nearr;</span>
        </a>
      </div>

    </div>
  </div>
</header>

<script>
  import { translations, type Language } from "@/data/translations";

  function applyLanguage(lang: Language) {
    const dict = translations[lang] || translations.en;
    document.documentElement.lang = lang;
    try {
      localStorage.setItem("renodotdev_lang", lang);
    } catch (e) {
      // storage unavailable
    }

    // Update all [data-i18n] text elements
    document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
      const key = el.getAttribute("data-i18n") as keyof typeof dict;
      if (key && dict[key]) {
        el.textContent = dict[key];
      }
    });

    // Update all [data-i18n-html] elements
    document.querySelectorAll<HTMLElement>("[data-i18n-html]").forEach((el) => {
      const key = el.getAttribute("data-i18n-html") as keyof typeof dict;
      if (key && dict[key]) {
        el.innerHTML = dict[key];
      }
    });

    // Update all [data-i18n-placeholder] inputs
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[data-i18n-placeholder]").forEach((el) => {
      const key = el.getAttribute("data-i18n-placeholder") as keyof typeof dict;
      if (key && dict[key]) {
        el.placeholder = dict[key];
      }
    });

    // Update switcher button styles across both desktop and mobile
    document.querySelectorAll<HTMLButtonElement>(".lang-switch-btn").forEach((btn) => {
      const btnLang = btn.getAttribute("data-lang");
      if (btnLang === lang) {
        btn.style.backgroundColor = "#97feed";
        btn.style.color = "#08090a";
        btn.style.borderColor = "#97feed";
      } else {
        btn.style.backgroundColor = "transparent";
        btn.style.color = "rgba(255, 255, 255, 0.5)";
        btn.style.borderColor = "transparent";
      }
    });

    window.dispatchEvent(new CustomEvent("renodotdev:lang-change", { detail: { lang } }));
  }

  (window as any).setRenodotdevLang = applyLanguage;

  function setupHeader() {
    const menuBtn = document.getElementById("menu-toggle-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("menu-icon-open");
    const iconClose = document.getElementById("menu-icon-close");

    const desktopLinks = document.querySelectorAll<HTMLAnchorElement>("#desktop-nav .nav-link");
    const mobileLinks = document.querySelectorAll<HTMLAnchorElement>(".mobile-nav-link");
    const allScrollLinks = document.querySelectorAll<HTMLAnchorElement>(
      ".nav-scroll-link, #desktop-nav .nav-link, .mobile-nav-link"
    );

    // Initial language setup
    let savedLang: Language = "en";
    try {
      const stored = localStorage.getItem("renodotdev_lang") as Language | null;
      if (stored === "id" || stored === "en") {
        savedLang = stored;
      }
    } catch (e) {
      // ignore
    }
    applyLanguage(savedLang);

    // Bind language switch buttons
    document.querySelectorAll<HTMLButtonElement>(".lang-switch-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const lang = btn.getAttribute("data-lang") as Language;
        if (lang === "en" || lang === "id") {
          applyLanguage(lang);
        }
      });
    });

    let isMenuOpen = false;

    function toggleMenu(open?: boolean) {
      isMenuOpen = open !== undefined ? open : !isMenuOpen;
      if (mobileMenu && iconOpen && iconClose && menuBtn) {
        if (isMenuOpen) {
          mobileMenu.classList.remove("hidden");
          mobileMenu.classList.add("block");
          iconOpen.classList.add("hidden");
          iconOpen.classList.remove("block");
          iconClose.classList.remove("hidden");
          iconClose.classList.add("block");
          menuBtn.setAttribute("aria-expanded", "true");
        } else {
          mobileMenu.classList.add("hidden");
          mobileMenu.classList.remove("block");
          iconOpen.classList.remove("hidden");
          iconOpen.classList.add("block");
          iconClose.classList.add("hidden");
          iconClose.classList.remove("block");
          menuBtn.setAttribute("aria-expanded", "false");
        }
      }
    }

    menuBtn?.addEventListener("click", () => toggleMenu());

    // Close menu on click outside
    document.addEventListener("click", (e) => {
      if (isMenuOpen && mobileMenu && menuBtn) {
        const target = e.target as Node;
        if (!mobileMenu.contains(target) && !menuBtn.contains(target)) {
          toggleMenu(false);
        }
      }
    });

    // Close menu on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isMenuOpen) {
        toggleMenu(false);
      }
    });

    // Intelligent cross-page & hash link handling
    allScrollLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href");
        if (!href) return;

        const currentPath = window.location.pathname.replace(/\/$/, "") || "/";

        if (href.startsWith("#")) {
          const targetId = href.slice(1);
          const el = document.getElementById(targetId);
          if (el) {
            e.preventDefault();
            toggleMenu(false);
            el.scrollIntoView({ behavior: "smooth" });
            history.pushState(null, "", href);
          } else {
            // Target is on homepage
            window.location.href = "/" + href;
          }
        } else if (href.includes("#")) {
          const [targetPath, hash] = href.split("#");
          const normalizedTarget = targetPath.replace(/\/$/, "") || "/";
          if (normalizedTarget === currentPath && hash) {
            const el = document.getElementById(hash);
            if (el) {
              e.preventDefault();
              toggleMenu(false);
              el.scrollIntoView({ behavior: "smooth" });
              history.pushState(null, "", "#" + hash);
            }
          } else {
            toggleMenu(false);
          }
        } else {
          toggleMenu(false);
        }
      });
    });

    const currentPathname = window.location.pathname.replace(/\/$/, "") || "/";
    const isProfilePage = currentPathname.startsWith("/profile");
    const isArticlesPage = currentPathname.startsWith("/articles");

    function setActiveSection(activeId: string) {
      desktopLinks.forEach((link) => {
        const sec = link.getAttribute("data-section");
        if (sec && sec === activeId) {
          link.classList.add("font-bold", "bg-white/10", "text-white");
          link.classList.remove("text-[#8b949e]");
          link.style.color = "#97feed";
        } else if (sec) {
          link.classList.remove("font-bold", "bg-white/10");
          link.classList.add("text-[#8b949e]");
          link.style.color = "";
        }
      });

      mobileLinks.forEach((link) => {
        const sec = link.getAttribute("data-section");
        if (sec && sec === activeId) {
          link.style.color = "#97feed";
          link.classList.add("font-bold", "bg-lime-400/10", "border-lime-400/30");
          link.classList.remove("border-transparent");
        } else if (sec) {
          link.style.color = "#8b949e";
          link.classList.remove("font-bold", "bg-lime-400/10", "border-lime-400/30");
          link.classList.add("border-transparent");
        }
      });
    }

    if (!isArticlesPage) {
      const sectionIds = isProfilePage
        ? ["home", "experience", "work", "contact"]
        : ["services", "work", "contact"];

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              setActiveSection(entry.target.id);
            }
          });
        },
        {
          rootMargin: "-15% 0px -75% 0px",
          threshold: 0,
        }
      );

      sectionIds.forEach((id) => {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
      });
    }
  }

  setupHeader();
  document.addEventListener("astro:page-load", setupHeader);
</script>
